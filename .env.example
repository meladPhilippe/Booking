# Local-only password used by Docker Compose to open ~/.aspnet/https/Payment.Api.pfx.
# Copy this file to .env and choose a password; never commit .env.
DEMO_HTTPS_PFX_PASSWORD=choose-a-local-password
MSSQL_SA_PASSWORD=choose-a-local-sql-password
STRIPE_SANDBOX_SECRET_KEY=sk_test_replace_me
STRIPE_SANDBOX_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SANDBOX_WEBHOOK_SIGNING_SECRET=whsec_replace_me
STRIPE_SANDBOX_RETURN_URL_ORIGIN=https://localhost:5173
PAYPAL_SANDBOX_CLIENT_ID=replace_me
PAYPAL_SANDBOX_CLIENT_SECRET=replace_me
PAYPAL_SANDBOX_WEBHOOK_ID=replace_me
